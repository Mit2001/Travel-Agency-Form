      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (const item of items) {\n\n  // ==========================\n  // Date Validation\n  // ==========================\n  const startDate = new Date(item.json[\"Travel Start Date\"]);\n  const today = new Date();\n\n  today.setHours(0, 0, 0, 0);\n  startDate.setHours(0, 0, 0, 0);\n\n  if (startDate < today) {\n    throw new Error(\n      \"Invalid Travel Start Date. Please select today's date or a future date.\"\n    );\n  }\n\n  // ==========================\n  // Phone Validation\n  // ==========================\n  const phone = String(item.json[\"Phone Number\"]).trim();\n\n  if (!/^\\d{10}$/.test(phone)) {\n    throw new Error(\n      \"Invalid Phone Number. Please enter a valid 10-digit phone number.\"\n    );\n  }\n\n  // ==========================\n  // Generate Inquiry ID\n  // ==========================\n  item.json[\"Inquiry ID\"] =\n    \"TRV-\" +\n    Date.now() +\n    \"-\" +\n    Math.floor(Math.random() * 1000);\n\n  // ==========================\n  // Calculate Return Date\n  // ==========================\n  const durationMap = {\n    \"3 Days 2 Nights\": 3,\n    \"4 Days 3 Nights\": 4,\n    \"5 Days 4 Nights\": 5,\n    \"7 Days 6 Nights\": 7,\n    \"10 Days 9 Nights\": 10,\n    \"14 Days 13 Nights\": 14,\n    \"15+ Days\": 15\n  };\n\n  const duration = item.json[\"Trip Duration\"];\n\n  if (durationMap[duration]) {\n    const returnDate = new Date(startDate);\n\n    returnDate.setDate(\n      returnDate.getDate() + durationMap[duration]\n    );\n\n    item.json[\"Estimated Return Date\"] =\n      returnDate.toISOString().split(\"T\")[0];\n  } else {\n    item.json[\"Estimated Return Date\"] = \"Not Specified\";\n  }\n\n  // ==========================\n  // Lead Status\n  // ==========================\n  item.json[\"Lead Status\"] = \"New Lead\";\n\n  // ==========================\n  // Submission Time\n  // ==========================\n  item.json[\"Processed At\"] = new Date().toISOString();\n}\n\nreturn items;"
      },
